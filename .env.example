# Copy this file to ".env" and fill in your own values. Never commit ".env".
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Option A: local PostgreSQL ---
DB_NAME=studymatch
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# --- Option B: Supabase (PostgreSQL). If DATABASE_URL is set it is used instead of Option A. ---
# Copy the connection string from Supabase: Project Settings > Database > Connection string (URI)
# DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres?sslmode=require

# Only emails ending with this domain can register (BR-01). Leave empty to allow any email while testing.
ALLOWED_EMAIL_DOMAIN=cit.edu
